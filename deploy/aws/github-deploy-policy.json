{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunOnlyTheDeploymentDocument",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:<AWS_REGION>::document/AWS-RunShellScript"
    },
    {
      "Sid": "RunOnlyOnTaggedCarRentalInstances",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:<AWS_REGION>:<AWS_ACCOUNT_ID>:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/Project": "car-rental"
        }
      }
    },
    {
      "Sid": "ReadOwnCommandResults",
      "Effect": "Allow",
      "Action": "ssm:GetCommandInvocation",
      "Resource": "*"
    }
  ]
}
