# Copy this file to .env and replace every CHANGE_ME value.
MYSQL_USER=car_rental_app
MYSQL_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_PASSWORD

# Image storage defaults to the Docker volume. For S3, set IMAGE_STORAGE_TYPE=s3
# and set a private bucket name. Do not put AWS access keys in this file.
IMAGE_STORAGE_TYPE=local
# S3_BUCKET=car-rental-images-<your-unique-suffix>
AWS_REGION=ap-northeast-2

# HTTPS is enabled after a certificate is issued. Keep http.conf for the first run.
APP_DOMAIN=example.com
NGINX_CONFIG=http.conf

# Leave these unset for local development. The EC2 deployment script supplies
# the private GHCR image and its immutable commit-SHA tag through .deploy.env.
# APP_IMAGE=ghcr.io/kimbh0218/car_rental_service
# APP_IMAGE_TAG=<40-character-commit-sha>
